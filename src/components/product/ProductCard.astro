---
import type { Product } from '../../lib/types.ts';
import { keyIngredients } from '../../lib/ingredients.ts';
import Img from '../ui/Img.astro';
import Price from './Price.astro';
import Rating from './Rating.astro';
import AddToBag from './AddToBag.astro';

interface Props {
  product: Product;
  index?: number;
  note?: string;
  compact?: boolean;
  headingLevel?: 'h3' | 'h4';
  sizes?: string;
  widths?: number[];
  class?: string;
  [key: string]: unknown;
}

const {
  product,
  index,
  note,
  compact = false,
  headingLevel = 'h3',
  sizes = '(min-width: 1024px) 22vw, (min-width: 768px) 33vw, 50vw',
  widths = [320, 480, 640, 800],
  class: className,
  ...rest
} = Astro.props;
const image = product.images[0];
const line = note ?? keyIngredients(product.description).slice(0, 3).join(' · ');
const Heading = headingLevel;
---

<article class:list={['card', { 'card--compact': compact }, className]} {...rest}>
  <a href={product.url} class="card__stage" tabindex="-1" aria-hidden="true" data-tilt>
    {image && <Img image={image} widths={widths} sizes={sizes} alt="" class="card__img" />}
  </a>
  <div class="card__body">
    <div class="card__meta">
      {index !== undefined && <span class="label muted tabular">{String(index).padStart(2, '0')}</span>}
      <Rating rating={product.rating} />
    </div>
    <Heading class="card__title">
      <a href={product.url}>{product.title}</a>
    </Heading>
    {line && <p class="card__note small muted">{line}</p>}
    <div class="card__buy">
      <Price product={product} />
      <AddToBag product={product} class="card__add" />
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 18px;
    min-width: 0;
  }
  .card__stage {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #F5E9EA;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .card__stage :global(.card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  .card:hover .card__stage :global(.card__img) {
    transform: scale(1.04);
  }
  .card__body {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 20px;
  }
  .card__title {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .card__title a {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-fast) var(--ease-out);
  }
  .card__title a:hover {
    background-size: 100% 1px;
  }
  .card__note {
    max-width: 34ch;
  }
  .card__buy {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }
  .card__buy :global(.card__add) {
    width: 100%;
  }
  .card--compact {
    grid-template-columns: 96px 1fr;
    grid-template-rows: none;
    align-items: start;
    gap: 16px;
  }
  .card--compact .card__stage {
    aspect-ratio: 1;
  }
  .card--compact .card__buy {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px 16px;
  }
  .card--compact .card__buy :global(.card__add) {
    width: auto;
  }
  @media (max-width: 599px) {
    .card__buy :global(.card__add) {
      padding: 0 12px;
    }
    .card--compact {
      grid-template-columns: 72px 1fr;
      gap: 14px;
    }
  }
</style>
