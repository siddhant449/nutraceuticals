---
import ProductCard from '../product/ProductCard.astro';
import { flagship, flagshipHandles } from '../../content/home.ts';
import { getProduct } from '../../lib/catalog.ts';

const products = flagshipHandles.map((h) => getProduct(h));
---

<section id="bestsellers" class="flagship section" aria-labelledby="flagship-title">
  <div class="container">
    <div class="flagship__head">
      <p class="label muted flagship__label" data-reveal="up">{flagship.label}</p>
      <h2 id="flagship-title" class="h2 flagship__title" data-reveal="lines">
        <span class="line"><span>{flagship.headline.lead}</span></span>
        <span class="line"><span><em>{flagship.headline.accent}</em></span></span>
      </h2>
      <div class="flagship__aside" data-reveal="up">
        <p class="muted">{flagship.body}</p>
        <a class="text-link" href={flagship.cta.href}>{flagship.cta.label}</a>
      </div>
    </div>

    <ul class="flagship__grid" role="list">
      {
        products.map((product, i) => (
          <li class:list={['flagship__item', { 'flagship__item--hero': i === 0 }]} data-reveal="up">
            <ProductCard
              product={product}
              index={i + 1}
              class={i === 0 ? 'card--hero' : undefined}
              sizes={i === 0 ? '(min-width: 1024px) 48vw, 100vw' : '(min-width: 1024px) 24vw, 50vw'}
              widths={i === 0 ? [640, 900, 1200, 1600] : [320, 480, 640, 800]}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .flagship__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 20px;
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  .flagship__label {
    grid-column: 1 / -1;
  }
  .flagship__title {
    grid-column: 1 / 8;
  }
  .flagship__title .line:nth-child(2) {
    padding-left: 0.9em;
  }
  .flagship__aside {
    grid-column: 9 / 13;
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  /* Hero product (half the width, full height) beside a 2×2 of the other four. */
  .flagship__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 56px var(--col-gap);
    list-style: none;
    padding: 0;
  }
  .flagship__item {
    grid-column: span 3;
  }
  /* The hero product stays in view (sticky) while the four smaller cards scroll past. */
  .flagship__item--hero {
    grid-column: 1 / 7;
    grid-row: 1 / 3;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .flagship__item--hero :global(.card--hero .card__stage) {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--header-h) - 300px);
    min-height: 420px;
  }
  .flagship__item--hero :global(.card--hero .card__title) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .flagship__item--hero :global(.card--hero .card__buy) {
    grid-template-columns: auto auto;
    justify-content: space-between;
    align-items: center;
  }
  .flagship__item--hero :global(.card--hero .card__add) {
    width: auto;
    min-width: 200px;
  }
  @media (max-width: 1023px) {
    .flagship__item--hero {
      grid-column: 1 / -1;
      grid-row: auto;
      position: static;
    }
    .flagship__item {
      grid-column: span 6;
    }
    .flagship__item--hero :global(.card--hero .card__stage) {
      max-height: none;
      min-height: 0;
    }
  }
  @media (max-width: 1023px) {
    .flagship__title,
    .flagship__aside {
      grid-column: 1 / -1;
    }
    .flagship__title .line:nth-child(2) {
      padding-left: 0;
    }
  }
  @media (max-width: 767px) {
    .flagship__grid {
      gap: 36px 14px;
    }
    .flagship__item--hero :global(.card--hero .card__buy) {
      grid-template-columns: 1fr;
    }
    .flagship__item--hero :global(.card--hero .card__add) {
      width: 100%;
    }
  }
</style>
