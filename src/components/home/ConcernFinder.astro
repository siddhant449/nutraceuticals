---
import Img from '../ui/Img.astro';
import ProductCard from '../product/ProductCard.astro';
import { concerns, concernsIntro } from '../../content/concerns.ts';
import { productsForConcern } from '../../lib/catalog.ts';

const entries = concerns.map((c) => ({ ...c, products: productsForConcern(c.id, 3) }));
---

<section class="concerns section" aria-labelledby="concerns-title">
  <div class="container">
    <div class="concerns__head">
      <p class="label muted" data-reveal="up">{concernsIntro.label}</p>
      <h2 id="concerns-title" class="h2" data-reveal="lines">
        <span class="line"><span>{concernsIntro.headline.lead}</span></span>
        <span class="line"><span><em>{concernsIntro.headline.accent}</em></span></span>
      </h2>
      <p class="muted concerns__intro" data-reveal="up">{concernsIntro.body}</p>
    </div>

    <div class="concerns__tabs" data-tabs>
      <div class="concerns__tablist" role="tablist" aria-label="Skin concerns">
        {
          entries.map((c, i) => (
            <button
              type="button"
              role="tab"
              id={`concern-tab-${c.id}`}
              aria-controls={`concern-panel-${c.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="concerns__tab"
            >
              <span class="label tabular">{String(i + 1).padStart(2, '0')}</span>
              <span>{c.label}</span>
            </button>
          ))
        }
      </div>

      {
        entries.map((c, i) => (
          <div
            role="tabpanel"
            id={`concern-panel-${c.id}`}
            aria-labelledby={`concern-tab-${c.id}`}
            class="concerns__panel"
            tabindex="0"
            hidden={i > 0}
          >
            <figure class="concerns__figure">
              <Img image={c.image} widths={[480, 720, 1000, 1200]} sizes="(min-width: 1024px) 36vw, 100vw" />
            </figure>
            <div class="concerns__detail">
              <h3 class="h3 concerns__panel-title">{c.label}</h3>
              <p class="muted">{c.intro}</p>
              <ul class="concerns__products" role="list">
                {c.products.map((p) => (
                  <li>
                    <ProductCard product={p} compact headingLevel="h4" sizes="112px" />
                  </li>
                ))}
              </ul>
              <a class="text-link" href={c.collectionUrl}>
                Shop all · {c.label}
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <p class="small muted concerns__disclaimer">{concernsIntro.disclaimer}</p>
  </div>
  <noscript>
    <style is:inline>
      .concerns__panel, .concerns__panel[hidden] { visibility: visible !important; grid-row: auto !important; margin-top: 32px; }
    </style>
  </noscript>
</section>

<style>
  .concerns {
    background: var(--c-porcelain-deep);
  }
  .concerns__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 20px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 80px);
  }
  .concerns__head > .label {
    grid-column: 1 / -1;
  }
  .concerns__head h2 {
    grid-column: 1 / 8;
  }
  .concerns__intro {
    grid-column: 9 / 13;
  }

  /* ---------- Stage ----------
     All five panels share ONE grid cell, so the stage is always as tall as the tallest panel and
     never jumps when the concern changes. The tab list, the photo and the detail column stretch
     to that same height: one top line, one bottom line. */
  .concerns__tabs {
    --stage-min: clamp(560px, 68vh, 700px);
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    grid-template-rows: auto;
    column-gap: clamp(24px, 3vw, 56px);
    padding-top: 28px;
    border-top: 1px solid var(--c-ink);
  }
  .concerns__tablist {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
  }
  .concerns__tab {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 0;
    border-bottom: 1px solid var(--c-border);
    text-align: left;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--c-text-muted);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .concerns__tab:hover {
    color: var(--c-ink);
  }
  .concerns__tab .label {
    flex: none;
    min-width: 2.2em;
    color: var(--c-text-muted);
  }
  /* Selected: ink text, persimmon index and dot, ink rule. Every label keeps the same left edge. */
  .concerns__tab::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-left: auto;
    border-radius: 50%;
    background: transparent;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .concerns__tab[aria-selected='true'] {
    color: var(--c-ink);
    border-bottom-color: var(--c-ink);
  }
  .concerns__tab[aria-selected='true'] .label {
    color: var(--c-persimmon-text);
  }
  .concerns__tab[aria-selected='true']::after {
    background: var(--c-persimmon);
  }
  .concerns__tab:focus-visible {
    outline: 2px solid var(--c-persimmon);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .concerns__panel {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
    gap: clamp(20px, 3vw, 48px);
    min-height: var(--stage-min);
  }
  /* Inactive panels keep their box (for the shared height) but are invisible and inert. */
  .concerns__panel[hidden] {
    display: grid;
    visibility: hidden;
  }
  .concerns__panel:focus-visible {
    outline-offset: 8px;
  }
  :global(.tabs-ready) .concerns__panel:not([hidden]) {
    animation: panel-in var(--dur-standard) var(--ease-out);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }
  .concerns__figure {
    margin: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
  }
  .concerns__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.tabs-ready) .concerns__panel:not([hidden]) .concerns__figure :global(img) {
    animation: figure-in 1.1s var(--ease-out);
  }
  @keyframes figure-in {
    from {
      transform: scale(1.06);
    }
  }
  .concerns__detail {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .concerns__panel-title {
    line-height: 1;
    margin-top: -0.08em;
  }
  .concerns__detail > p {
    max-width: 44ch;
  }
  .concerns__products {
    display: grid;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }
  /* Compact product rows: one-line ingredients, price and button on one line. */
  .concerns__products :global(.card--compact) {
    grid-template-columns: 104px 1fr;
    gap: 16px;
    align-items: center;
  }
  .concerns__products :global(.card__body) {
    gap: 4px;
  }
  .concerns__products :global(.card__note) {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: none;
  }
  .concerns__products :global(.card__buy) {
    flex-wrap: nowrap;
    margin-top: 6px;
  }
  .concerns__products :global(.add-btn) {
    min-height: 40px;
    padding: 0 16px;
  }
  /* The collection link sits on the stage's bottom line, level with the photo and the last tab. */
  .concerns__detail > .text-link {
    margin-top: auto;
    align-self: flex-start;
  }
  .concerns__disclaimer {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--c-border);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.tabs-ready) .concerns__panel:not([hidden]),
    :global(.tabs-ready) .concerns__panel:not([hidden]) .concerns__figure :global(img) {
      animation: none;
    }
  }

  /* ---------- Tablet & mobile: pill row, then one shared cell for the panels ---------- */
  @media (max-width: 1023px) {
    .concerns__head h2,
    .concerns__intro {
      grid-column: 1 / -1;
    }
    .concerns__tabs {
      grid-template-columns: minmax(0, 1fr);
      border-top: 0;
      padding-top: 0;
    }
    .concerns__tablist {
      grid-row: 1;
      flex-direction: row;
      overflow-x: auto;
      gap: 8px;
      padding-bottom: 20px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .concerns__tablist::-webkit-scrollbar {
      display: none;
    }
    .concerns__tab,
    .concerns__tab:first-child {
      flex: none;
      min-height: 44px;
      padding: 10px 18px;
      border: 1px solid var(--c-border);
      border-radius: 999px;
      font-size: 0.9375rem;
      scroll-snap-align: start;
    }
    .concerns__tab::after {
      display: none;
    }
    .concerns__tab[aria-selected='true'] {
      background: var(--c-ink);
      border-color: var(--c-ink);
      color: var(--c-porcelain);
    }
    .concerns__tab[aria-selected='true'] .label {
      color: var(--c-silver);
    }
    .concerns__tab:focus-visible {
      outline-offset: 2px;
      border-radius: 999px;
    }
    .concerns__panel {
      grid-column: 1;
      grid-row: 2;
      min-height: 0;
    }
    .concerns__figure {
      aspect-ratio: 4 / 5;
    }
  }
  @media (max-width: 767px) {
    .concerns__panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .concerns__figure {
      aspect-ratio: 5 / 4;
    }
    .concerns__products :global(.card--compact) {
      grid-template-columns: 84px 1fr;
    }
    .concerns__products :global(.card__buy) {
      flex-wrap: wrap;
    }
  }
</style>
