---
import Img from '../ui/Img.astro';
import Button from '../ui/Button.astro';
import Price from '../product/Price.astro';
import { closing } from '../../content/home.ts';
import { rating } from '../../content/site.ts';
import { getProduct } from '../../lib/catalog.ts';

const bundle = getProduct(closing.productHandle);
---

<section class="closing" aria-labelledby="closing-title">
  <div class="closing__media" data-reveal="mask" aria-hidden="true">
    <Img image={closing.image} widths={[800, 1200, 1800, 2400]} sizes="100vw" alt="" data-parallax="6" />
  </div>
  <div class="closing__wash" aria-hidden="true"></div>

  <div class="container closing__content">
    <p class="closing__rating" data-reveal="up">
      <span class="closing__stars" aria-hidden="true">
        {
          Array.from({ length: 5 }, () => (
            <svg viewBox="0 0 13 12">
              <path d="M6.5 0l1.9 3.9 4.3.6-3.1 3 .7 4.3L6.5 9.8 2.6 11.8l.7-4.3-3.1-3 4.3-.6z" fill="currentColor" />
            </svg>
          ))
        }
      </span>
      <span><strong>{rating.value}/5</strong> from {rating.reviews} reviews</span>
    </p>

    <h2 id="closing-title" class="closing__title" data-reveal="lines">
      <span class="line"><span>{closing.headline.lead} <em>{closing.headline.accent}</em></span></span>
      <span class="line"><span>{closing.headline.tail}</span></span>
    </h2>

    <ul class="closing__reasons" role="list">
      {
        closing.reasons.map((reason) => (
          <li data-reveal="up">
            <svg class="closing__check" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.2" />
              <path d="M7.5 12.3l3 3 6-6.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{reason}</span>
          </li>
        ))
      }
    </ul>

    <div class="closing__ctas" data-reveal="up">
      <Button href={bundle.url}>{closing.cta.label}</Button>
      <div class="closing__bundle">
        <span class="closing__bundle-title">{bundle.title}</span>
        <Price product={bundle} />
      </div>
    </div>
    <a class="text-link" href={closing.secondary.href} data-reveal="up">{closing.secondary.label}</a>
  </div>
</section>

<style>
  .closing {
    position: relative;
    min-height: clamp(640px, 100svh, 1080px);
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .closing__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: #ede7dc;
  }
  .closing__media :global(img) {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
  }
  .closing__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 48%, rgba(243, 240, 233, 0.82) 0%, rgba(243, 240, 233, 0.55) 55%, rgba(243, 240, 233, 0.2) 100%);
  }
  .closing__content {
    display: grid;
    justify-items: center;
    gap: clamp(24px, 3vw, 40px);
    padding-block: var(--section-y);
    text-align: center;
  }
  .closing__rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-small);
    color: var(--c-text-muted);
  }
  .closing__rating strong {
    color: var(--c-ink);
    font-weight: 500;
  }
  .closing__stars {
    display: inline-flex;
    gap: 3px;
    color: var(--c-persimmon);
  }
  .closing__stars svg {
    width: 13px;
    height: 12px;
  }
  .closing__title {
    font-size: clamp(3rem, 1rem + 6.6vw, 9rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .closing__title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    font-size: 1.06em;
    color: var(--c-persimmon-text);
  }
  .closing__reasons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(100%, 980px);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }
  .closing__reasons li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 12px;
    padding: 24px clamp(12px, 2vw, 32px);
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  .closing__reasons li + li {
    border-left: 1px solid var(--c-border);
  }
  .closing__check {
    width: 26px;
    height: 26px;
    color: var(--c-persimmon-text);
  }
  .closing__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 28px;
  }
  .closing__bundle {
    display: grid;
    justify-items: start;
    gap: 2px;
    text-align: left;
  }
  .closing__bundle-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.1;
  }
  @media (max-width: 767px) {
    .closing__reasons {
      grid-template-columns: minmax(0, 1fr);
    }
    .closing__reasons li + li {
      border-left: 0;
      border-top: 1px solid var(--c-border);
    }
    .closing__bundle {
      justify-items: center;
      text-align: center;
    }
  }
</style>
