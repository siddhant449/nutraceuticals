---
import Img from '../ui/Img.astro';
import { beforeAfters, featuredReviewName, resultsIntro, reviews } from '../../content/results.ts';
import { live, rating } from '../../content/site.ts';
import { getProduct } from '../../lib/catalog.ts';

// The featured review lives in the red-gel QuoteInterlude that follows this section.
const others = reviews.filter((r) => r.name !== featuredReviewName);
---

<section class="results section" aria-labelledby="results-title">
  <div class="container">
    <div class="results__head">
      <p class="label muted" data-reveal="up">{resultsIntro.label}</p>
      <h2 id="results-title" class="h2" data-reveal="lines">
        <span class="line"><span>{resultsIntro.headline.lead}</span></span>
        <span class="line"><span><em>{resultsIntro.headline.accent}</em></span></span>
      </h2>
      <div class="results__summary" data-reveal="up">
        <p class="results__score">
          <span class="results__score-value tabular">{rating.value}</span>
          <span class="small muted">average from {rating.reviews} reviews on seoulceuticals.com</span>
        </p>
        <a class="text-link" href={live('/pages/reviews')}>Read all reviews</a>
      </div>
    </div>

    <ul class="results__grid" role="list">
      {
        beforeAfters.map((pair) => (
          <li data-reveal="up">
            <figure class="compare" data-compare>
              <div class="compare__frame">
                <Img image={pair.before} widths={[320, 480, 720]} sizes="(min-width: 1024px) 24vw, 50vw" class="compare__img" />
                <div class="compare__after">
                  <Img image={pair.after} widths={[320, 480, 720]} sizes="(min-width: 1024px) 24vw, 50vw" class="compare__img" />
                </div>
                <span class="compare__tag compare__tag--before label" aria-hidden="true">Before</span>
                <span class="compare__tag compare__tag--after label" aria-hidden="true">After</span>
                <span class="compare__handle" aria-hidden="true">
                  <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
                    <path d="M5 1L1 5l4 4M13 1l4 4-4 4" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </span>
                <input
                  class="compare__range"
                  type="range"
                  min="0"
                  max="100"
                  value="50"
                  step="1"
                  aria-label={`Before and after comparison, customer photo ${pair.id}`}
                  aria-valuetext="50% after"
                />
              </div>
            </figure>
          </li>
        ))
      }
    </ul>
    <p class="small muted results__disclosure">{resultsIntro.disclosure}</p>

    <ul class="results__quotes" role="list">
      {
        others.map((r) => {
          const product = getProduct(r.productHandle);
          return (
            <li data-reveal="up">
              <figure class="quote">
                <blockquote>
                  <p>“{r.text}”</p>
                </blockquote>
                <figcaption class="results__cite">
                  <span class="results__name">{r.name}</span>
                  <span class="label muted">{r.label}</span>
                  <a href={product.url} class="small">
                    Using the {product.title}
                  </a>
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>
    <p class="small muted results__source">Reviews shown as published on the seoulceuticals.com homepage.</p>
  </div>
</section>

<style>
  .results__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 20px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 80px);
  }
  .results__head > .label {
    grid-column: 1 / -1;
  }
  .results__head h2 {
    grid-column: 1 / 8;
  }
  .results__summary {
    grid-column: 9 / 13;
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .results__score {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .results__score-value {
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .results__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--col-gap);
    list-style: none;
    padding: 0;
  }
  .compare {
    margin: 0;
  }
  .compare__frame {
    --pos: 50%;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--c-porcelain-deep);
    user-select: none;
  }
  .compare__frame :global(.compare__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .compare__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }
  .compare__tag {
    position: absolute;
    top: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(243, 240, 233, 0.88);
    color: var(--c-ink);
    pointer-events: none;
  }
  .compare__tag--before {
    left: 12px;
  }
  .compare__tag--after {
    right: 12px;
  }
  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 0;
    pointer-events: none;
  }
  .compare__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.5px;
    width: 1px;
    background: var(--c-porcelain);
  }
  .compare__handle svg {
    position: absolute;
    top: 50%;
    left: 0;
    width: 44px;
    height: 44px;
    max-width: none;
    padding: 17px 13px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--c-porcelain);
    color: var(--c-ink);
    box-shadow: 0 6px 18px rgba(25, 27, 25, 0.18);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .compare__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .compare__frame:has(.compare__range:focus-visible) {
    outline: 2px solid var(--c-persimmon);
    outline-offset: 3px;
  }
  .compare__frame:has(.compare__range:active) .compare__handle svg {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .results__disclosure {
    margin-top: 16px;
  }
  .results__cite {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .results__cite a {
    color: var(--c-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-border);
  }
  .results__cite a:hover {
    color: var(--c-ink);
    text-decoration-color: currentColor;
  }
  .results__name {
    font-weight: 500;
  }
  .results__quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
    list-style: none;
    padding: 0;
    margin-top: clamp(56px, 7vw, 112px);
    border-top: 1px solid var(--c-border);
  }
  .quote {
    margin: 0;
    display: grid;
    align-content: space-between;
    gap: 28px;
    height: 100%;
    padding: 28px 0;
  }
  .quote blockquote {
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .results__quotes li + li .quote {
    padding-left: var(--col-gap);
    border-left: 1px solid var(--c-border);
  }
  .results__source {
    margin-top: 8px;
  }
  @media (max-width: 1023px) {
    .results__head h2,
    .results__summary {
      grid-column: 1 / -1;
    }
    .results__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .results__quotes {
      grid-template-columns: minmax(0, 1fr);
    }
    .results__quotes li + li .quote {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--c-border);
    }
  }
</style>
