---
import Img from '../ui/Img.astro';
import { featuredReviewName, quoteTexture, reviews } from '../../content/results.ts';
import { getProduct } from '../../lib/catalog.ts';

const review = reviews.find((r) => r.name === featuredReviewName)!;
const product = getProduct(review.productHandle);
// Split the quote into three length-balanced lines for the masked line reveal.
const LINES = 3;
const words = review.text.split(' ');
const target = review.text.length / LINES;
const lines: string[] = [];
let current = '';
for (const word of words) {
  const next = current ? `${current} ${word}` : word;
  if (current && next.length > target * 1.08 && lines.length < LINES - 1) {
    lines.push(current);
    current = word;
  } else current = next;
}
lines.push(current);
---

<section class="interlude" data-interlude data-header-theme="dark" aria-label="Customer review">
  <div class="interlude__mask" data-interlude-mask>
    <div class="interlude__scale" data-interlude-scale>
      <div class="interlude__drift">
        <Img image={quoteTexture} widths={[800, 1200, 1800, 2400]} sizes="100vw" alt="" class="interlude__img" />
      </div>
    </div>
    <div class="interlude__light" aria-hidden="true"></div>
    <div class="interlude__shade" aria-hidden="true"></div>

    <figure class="interlude__content container">
      <blockquote class="interlude__quote" data-reveal="lines">
        <p>
          {
            lines.map((line, i) => (
              <span class="line">
                <span>
                  {i === 0 && '“'}
                  {line}
                  {i === lines.length - 1 && '”'}
                </span>
              </span>
            ))
          }
        </p>
      </blockquote>
      <figcaption class="interlude__cite label" data-reveal="up">
        <span>{review.name}{review.label && ` · ${review.label}`}</span>{' · '}
        <a href={product.url}>Using the {product.title}</a>
        <span class="interlude__note">Customer review shown as published on seoulceuticals.com. Individual experiences vary.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .interlude {
    position: relative;
    background: var(--c-porcelain);
  }
  .interlude__mask {
    position: relative;
    min-height: clamp(560px, 92svh, 980px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #9E0E2E;
    color: var(--c-porcelain);
    isolation: isolate;
  }
  /* Pre-state for the "drop spreading" reveal; only while the motion system owns it. */
  :global(html.motion) .interlude__mask {
    clip-path: ellipse(9% 7% at 50% 52%);
  }
  .interlude__scale,
  .interlude__drift {
    position: absolute;
    inset: 0;
  }
  .interlude__scale {
    z-index: -3;
    will-change: transform;
  }
  .interlude__drift :global(.interlude__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .interlude__drift {
    transform: scale(1.12);
  }
  :global(html.motion) .interlude__drift {
    animation: gel-drift 26s ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  :global(html.motion) .interlude:global(.is-live) .interlude__drift {
    animation-play-state: running;
  }
  @keyframes gel-drift {
    0% {
      transform: scale(1.12) translate3d(-1.5%, -1%, 0) rotate(-0.6deg);
    }
    50% {
      transform: scale(1.18) translate3d(1%, 1.2%, 0) rotate(0.4deg);
    }
    100% {
      transform: scale(1.14) translate3d(1.8%, -1.4%, 0) rotate(-0.2deg);
    }
  }
  /* Light catching the gel surface — follows the pointer on desktop. */
  .interlude__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(
      circle at calc(var(--lx, 62) * 1%) calc(var(--ly, 38) * 1%),
      rgba(255, 236, 240, 0.32) 0%,
      rgba(255, 236, 240, 0.08) 22%,
      transparent 48%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .interlude__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 50%, rgba(70, 0, 14, 0.18), rgba(70, 0, 14, 0.38));
    pointer-events: none;
  }
  .interlude__content {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 28px;
    padding-block: clamp(96px, 12vw, 180px);
    text-align: center;
  }
  .interlude__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 1.1rem + 4.2vw, 5.75rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }
  .interlude__quote .line {
    padding-bottom: 0.1em;
  }
  @media (min-width: 768px) {
    .interlude__quote .line > span {
      white-space: nowrap;
    }
  }
  .interlude__cite {
    color: rgba(243, 240, 233, 0.86);
    max-width: 60ch;
    line-height: 1.7;
  }
  .interlude__note {
    display: block;
    margin-top: 10px;
    text-transform: none;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }
  .interlude__cite a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(243, 240, 233, 0.4);
  }
  .interlude__cite a:hover {
    text-decoration-color: currentColor;
  }
  .interlude :global(:focus-visible) {
    outline-color: var(--c-porcelain);
  }
  @media (prefers-reduced-motion: reduce) {
    .interlude__drift {
      animation: none !important;
    }
  }
</style>
