---
import { footerGroups, newsletter, shipping, signOff } from '../../content/site.ts';
import Button from '../ui/Button.astro';

const [lead, accent] = signOff.split('. ');
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__intro">
        <p class="h2 site-footer__signoff">{lead}. <em>{accent}</em></p>
        <div class="site-footer__newsletter">
          <p class="label muted">Newsletter</p>
          <p>{newsletter.title}</p>
          <Button href={newsletter.cta.href} variant="ghost">{newsletter.cta.label}</Button>
        </div>
      </div>
      <nav class="site-footer__nav" aria-label="Footer">
        {
          footerGroups.map((group) => (
            <div class="site-footer__group">
              <h2 class="label muted">{group.title}</h2>
              <ul role="list">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="site-footer__bottom small muted">
      <p>© {new Date().getFullYear()} SeoulCeuticals. Founded in the U.S. in 2016.</p>
      <p>{shipping}</p>
      <p>Design prototype. Shopping hands off to seoulceuticals.com.</p>
    </div>
  </div>
  <div class="site-footer__wordmark" aria-hidden="true">
    <span>Seoul</span><span class="serif">Ceuticals</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--c-porcelain-deep);
    padding-top: clamp(80px, 10vw, 160px);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(48px, 6vw, 120px);
  }
  .site-footer__signoff {
    max-width: 15ch;
    font-size: clamp(2.25rem, 1.3rem + 3vw, 4.5rem);
    hyphens: manual;
  }
  .site-footer__newsletter {
    display: grid;
    gap: 14px;
    justify-items: start;
    margin-top: clamp(32px, 4vw, 56px);
    max-width: 34ch;
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 24px;
  }
  .site-footer__group h2 {
    margin-bottom: 14px;
  }
  .site-footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    font-size: 0.9375rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-footer__group a:hover {
    color: var(--c-persimmon-text);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    justify-content: space-between;
    margin-top: clamp(56px, 7vw, 120px);
    padding-top: 24px;
    border-top: 1px solid var(--c-border);
  }
  .site-footer__wordmark {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.04em;
    margin-top: clamp(24px, 4vw, 56px);
    margin-bottom: -0.22em;
    font-size: clamp(4rem, 17.4vw, 22rem);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: #DDD7CB;
    white-space: nowrap;
    user-select: none;
  }
  .site-footer__wordmark .serif {
    font-size: 1.04em;
    letter-spacing: -0.03em;
  }
  @media (max-width: 1023px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .site-footer__bottom {
      flex-direction: column;
    }
  }
</style>
