---
import { live, logo, primaryNav, withBase } from '../../content/site.ts';
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={withBase('')} class="site-header__logo">
      <img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul role="list">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__icon" href={live('/search')} aria-label="Search seoulceuticals.com">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="6" stroke="currentColor" stroke-width="1.3"></circle>
          <path d="M12 12l5 5" stroke="currentColor" stroke-width="1.3"></path>
        </svg>
      </a>
      <button
        type="button"
        class="site-header__bag"
        data-bag-open
        aria-haspopup="dialog"
        aria-controls="bag-drawer"
      >
        <span>Bag</span>
        <span class="site-header__count tabular" data-bag-count aria-hidden="true">0</span>
        <span class="visually-hidden" data-bag-count-label>, 0 items</span>
      </button>
      <button
        type="button"
        class="site-header__menu"
        data-menu-open
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">Open menu</span>
        <span class="site-header__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header-sentinel {
    position: absolute;
    top: 80px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--c-ink);
    transition:
      background-color var(--dur-standard) var(--ease-out),
      box-shadow var(--dur-standard) var(--ease-out),
      transform var(--dur-standard) var(--ease-out);
  }
  .site-header:global(.is-solid) {
    background-color: color-mix(in srgb, var(--c-porcelain) 90%, transparent);
    box-shadow: 0 1px 0 var(--c-border);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
  }
  .site-header:global(.is-dark) {
    color: var(--c-on-dark);
  }
  .site-header:global(.is-solid.is-dark) {
    background-color: color-mix(in srgb, var(--c-graphite) 88%, transparent);
    box-shadow: 0 1px 0 var(--c-border-dark);
  }
  .site-header:global(.is-dark) .site-header__count {
    border-color: var(--c-border-dark);
  }
  .site-header:global(.is-dark) .site-header__count:global(.has-items) {
    background: var(--c-porcelain);
    border-color: var(--c-porcelain);
    color: var(--c-ink);
  }
  .site-header__inner {
    height: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 32px;
  }
  .site-header__logo {
    display: block;
    width: clamp(118px, 10vw, 150px);
  }
  .site-header__logo img {
    width: 100%;
    height: auto;
  }
  .site-header__nav ul {
    display: flex;
    justify-content: center;
    gap: clamp(18px, 2.4vw, 40px);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .site-header__icon,
  .site-header__menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }
  .site-header__bag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 6px 0 10px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .site-header__count {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 7px;
    border-radius: 999px;
    border: 1px solid var(--c-border);
    font-size: 0.75rem;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .site-header__count:global(.has-items) {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-porcelain);
  }
  .site-header__menu {
    display: none;
  }
  .site-header__burger {
    display: grid;
    gap: 6px;
    width: 22px;
  }
  .site-header__burger i {
    display: block;
    height: 1.3px;
    background: currentColor;
  }

  @media (max-width: 1023px) {
    .site-header__nav {
      display: none;
    }
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }
    .site-header__menu {
      display: grid;
    }
  }
</style>
