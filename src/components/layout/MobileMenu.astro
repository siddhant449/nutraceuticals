---
import { logo, primaryNav, secondaryNav, shipping } from '../../content/site.ts';
---

<dialog id="mobile-menu" class="menu" aria-label="Menu" data-menu data-lenis-prevent>
  <div class="menu__panel">
    <div class="container menu__head">
      <img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} class="menu__logo" />
      <button type="button" class="menu__close" data-dialog-close>
        <span>Close</span>
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.3"></path>
        </svg>
      </button>
    </div>
    <nav class="container menu__nav" aria-label="Mobile">
      <ul role="list" class="menu__primary">
        {
          primaryNav.map((item, i) => (
            <li>
              <a href={item.href} data-menu-link>
                <span class="menu__index label tabular">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="menu__secondary">
        {
          secondaryNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="container label menu__foot">{shipping}</p>
  </div>
</dialog>

<style>
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-porcelain);
    color: var(--c-ink);
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu[open] .menu__panel {
    animation: menu-in var(--dur-standard) var(--ease-out);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .menu__panel {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }
  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }
  .menu__logo {
    width: 118px;
    height: auto;
  }
  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .menu__nav {
    flex: 1;
    padding-top: 6vh;
  }
  .menu__primary a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    border-bottom: 1px solid var(--c-border);
  }
  .menu__index {
    color: var(--c-text-muted);
    min-width: 2.5em;
  }
  .menu__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 16px;
    margin-top: 32px;
  }
  .menu__secondary a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 0.9375rem;
    color: var(--c-text-muted);
  }
  .menu__foot {
    padding-block: 24px;
    color: var(--c-text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu[open] .menu__panel {
      animation: none;
    }
  }
</style>
