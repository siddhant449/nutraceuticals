---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import Philosophy from '../components/home/Philosophy.astro';
import FormulaChapter from '../components/home/FormulaChapter.astro';
import Flagship from '../components/home/Flagship.astro';
import ConcernFinder from '../components/home/ConcernFinder.astro';
import Results from '../components/home/Results.astro';
import Ritual from '../components/home/Ritual.astro';
import QuoteInterlude from '../components/home/QuoteInterlude.astro';
import BrandStory from '../components/home/BrandStory.astro';
import Faq from '../components/home/Faq.astro';
import Promise from '../components/home/Promise.astro';
import Closing from '../components/home/Closing.astro';
---

<BaseLayout
  title="SeoulCeuticals | Korean-Inspired Skincare with PDRN & Snail Mucin"
  description="Korean-inspired ingredients meet modern skincare actives in thoughtfully formulated essentials for your daily ritual."
>
  <main id="main">
    <Hero />
    <ProofStrip />
    <Philosophy />
    <FormulaChapter />
    <Flagship />
    <ConcernFinder />
    <Results />
    <QuoteInterlude />
    <Ritual />
    <BrandStory />
    <Faq />
    <Promise />
    <Closing />
  </main>
</BaseLayout>
